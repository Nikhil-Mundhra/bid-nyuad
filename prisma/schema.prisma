generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum CurrencyCode {
  MEAL_SWIPE
  FLEX_DIRHAM
  CAMPUS_DIRHAM
  FALCON_DIRHAM
  REAL_DIRHAM
}

enum BidStatus {
  ACTIVE
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum TradeStatus {
  ACCEPTED
  COMPLETED
  FAILED
}

enum MessageType {
  TEXT
  SYSTEM
  WHATSAPP_REVEAL
}

enum NotificationType {
  HIGHEST_BID
  BID_ACCEPTED
  TRADE_MESSAGE
  TRADE_COMPLETED
  TRADE_FAILED
}

model User {
  id                 String               @id @default(cuid())
  netId              String               @unique
  email              String               @unique
  whatsappNumber     String?
  privateEmail       String?
  verificationStatus VerificationStatus   @default(PENDING)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  sessions           Session[]
  verificationLogs   VerificationAttempt[]
  bids               Bid[]                @relation("BuyerBids")
  sellerTrades       Trade[]              @relation("SellerTrades")
  buyerTrades        Trade[]              @relation("BuyerTrades")
  messages           ChatMessage[]
  notifications      Notification[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationAttempt {
  id              String             @id @default(cuid())
  userId          String?
  uploadedIdRef   String?
  extractedNetId  String
  otpHash         String
  expiresAt       DateTime
  attemptCount    Int                @default(0)
  status          VerificationStatus @default(PENDING)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  user            User?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([extractedNetId])
  @@index([userId])
}

model Currency {
  id            String       @id @default(cuid())
  code          CurrencyCode @unique
  displayName   String
  hierarchyRank Int
  createdAt     DateTime     @default(now())
  baseMarkets   Market[]     @relation("BaseCurrency")
  quoteMarkets  Market[]     @relation("QuoteCurrency")
}

model Market {
  id              String   @id @default(cuid())
  slug            String   @unique
  baseCurrencyId  String
  quoteCurrencyId String
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  baseCurrency    Currency @relation("BaseCurrency", fields: [baseCurrencyId], references: [id])
  quoteCurrency   Currency @relation("QuoteCurrency", fields: [quoteCurrencyId], references: [id])
  bids            Bid[]

  @@unique([baseCurrencyId, quoteCurrencyId])
}

model Bid {
  id          String    @id @default(cuid())
  marketId    String
  buyerId     String
  baseAmount  Decimal   @db.Decimal(12, 2)
  quoteAmount Decimal   @db.Decimal(12, 2)
  rate        Decimal   @db.Decimal(12, 6)
  status      BidStatus @default(ACTIVE)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  market      Market    @relation(fields: [marketId], references: [id])
  buyer       User      @relation("BuyerBids", fields: [buyerId], references: [id])
  trade       Trade?

  @@index([marketId, status, rate])
  @@index([buyerId])
}

model Trade {
  id                   String        @id @default(cuid())
  bidId                String        @unique
  buyerId              String
  sellerId             String
  status               TradeStatus   @default(ACCEPTED)
  whatsappRevealedAt   DateTime?
  sellerConfirmedAt    DateTime?
  sellerFailureReason  String?
  completedAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  bid                  Bid           @relation(fields: [bidId], references: [id])
  buyer                User          @relation("BuyerTrades", fields: [buyerId], references: [id])
  seller               User          @relation("SellerTrades", fields: [sellerId], references: [id])
  messages             ChatMessage[]

  @@index([buyerId])
  @@index([sellerId])
}

model ChatMessage {
  id        String      @id @default(cuid())
  tradeId   String
  senderId  String
  body      String
  type      MessageType @default(TEXT)
  createdAt DateTime    @default(now())
  trade     Trade       @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  sender    User        @relation(fields: [senderId], references: [id])

  @@index([tradeId, createdAt])
  @@index([senderId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  payload   Json
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}
