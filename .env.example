# Supabase project URL. Used publicly for client-safe project metadata and
# server-side for Storage uploads when SUPABASE_URL is not set separately.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-or-publishable-key"

# Supabase server-only credentials for private ID-card uploads.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_ID_UPLOAD_BUCKET="nyuad-id-uploads"

# Google Cloud Vision OCR for uploaded ID cards. Configure one credentials mode.
# GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/service-account.json"
# GOOGLE_CREDENTIALS_JSON='{"type":"service_account","project_id":"bid-nyuad","client_email":"ocr-817@bid-nyuad.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}'

# Use your Supabase Postgres connection string in production.
# For local-only Docker Postgres, keep the localhost value below.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bid_nyuad?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SESSION_SECRET="replace-with-a-long-random-value"

# Preferred OTP email delivery: Mailjet Send API.
MAILJET_API_KEY="your-mailjet-api-key"
MAILJET_SECRET_KEY="your-mailjet-secret-key"
MAILJET_SENDER_ADDRESS="verified-sender@example.com"

# Optional fallback when Mailjet is not configured.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp-user"
SMTP_PASS="smtp-password"
SMTP_FROM="Bid-NYUAD <no-reply@bid-nyuad.local>"
